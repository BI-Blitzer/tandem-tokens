{
  "permissions": {
    "allow": [
      "Bash(ollamaq:*)",
      "Bash(python -m ollamaq.cli:*)",
      "Bash(py -m ollamaq.cli:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/auto_offload.py"
          }
        ]
      }
    ]
  }
}
